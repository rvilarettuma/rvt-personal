# Dependencies
node_modules/

# Vite build output — this is generated by the GitHub Actions workflow
# on every push and published to Pages; it should never be committed.
dist/
dist-ssr/

# Vite cache
.vite/

# Env files — none in use yet, but ignored preemptively so a local
# .env with secrets/API keys can never be committed by accident.
.env
.env.local
.env.*.local

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor / OS
.DS_Store
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
